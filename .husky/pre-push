#!/usr/bin/env sh
if ! command -v npm >/dev/null 2>&1; then
  echo "⚠️  npm not found in PATH — skipping pre-push hooks"
  echo "   Run 'npm test' manually before pushing."
  exit 0
fi

if ! node -e 'const major=Number(process.versions.node.split(".")[0]);process.exit([20,22,24].includes(major)?0:1)'; then
  echo "❌ Unsupported Node.js runtime for OmniRoute pre-push tests: $(node --version)"
  echo "   Use the version in .node-version (Node 24) before pushing."
  exit 1
fi

npm run test:unit
